# 部署脚本在 Linux 上执行，必须是 LF。
# Windows 下 core.autocrlf 默认会把工作区文件转成 CRLF，
# 一旦脚本被转成 CRLF，服务器上会直接报 "bad interpreter: /bin/bash^M"。
*.sh text eol=lf

# Flyway 迁移脚本必须是 LF。
# Flyway 按文件字节算 checksum，同一份 V1 在 Windows（CRLF）和 Linux（LF）
# 打包出来的 checksum 不同 —— 本地跑过、CI 构建后就报 Migration checksum mismatch。
*.sql text eol=lf

# 环境变量文件必须是 LF。
# docker compose 的 env_file 按行读 KEY=VALUE，CRLF 会让值末尾带上一个 \r，
# 于是密码变成 "xxxx\r" —— 报 Access denied，但用 cat 看完全正常，极难发现。
*.env text eol=lf
*.env.example text eol=lf

# Dockerfile 里 RUN 的多行续行靠行尾反斜杠，CRLF 会让 \r 混进命令参数。
Dockerfile text eol=lf
.dockerignore text eol=lf

# 编排与配置统一 LF：YAML 能容忍 CRLF，但换行符不一致会让 diff 噪音变大
docker-compose.yml text eol=lf
*.yml text eol=lf
*.conf text eol=lf

# 这个文件本身也必须保持 LF，否则 CRLF 会让上面的模式匹配失效
.gitattributes text eol=lf
