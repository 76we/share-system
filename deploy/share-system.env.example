# 复制到服务器 /opt/share/share-system.env，然后执行：
#   chown share:share /opt/share/share-system.env
#   chmod 600 /opt/share/share-system.env
# 这个文件不要提交到 git（deploy/*.env 已在 .gitignore 中排除）

SERVER_PORT=8080

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sharing
DB_USERNAME=share
DB_PASSWORD=换成真实密码
DB_POOL_SIZE=20

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis 没有设密码时，把下面这行留空，并且把 application-prod.yml 里的
# password 那一行整行注释掉，否则会带着空密码去 AUTH 而报错
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 上传目录 ----------
# 必须与 nginx-share-system.conf 里 /images/ 的 alias 一致
# 建议指向独立数据盘（例如 /data/uploads/），不要放系统盘：
# 图片把系统盘写满会连带 MySQL 与日志一起挂
UPLOAD_DIR=/opt/share/uploads/

# ---------- 图片回收 ----------
# 删除动态是软删（status=0），满 PURGE_DAYS 天后由定时任务物理删除
# moment_image 行与磁盘文件。默认保留 30 天，留出误删恢复的窗口。
PHOTO_PURGE_ENABLED=true
PHOTO_PURGE_DAYS=30
# 每天 03:40，避开备份（03:00）。带空格，必须加引号，否则 systemd 读进来会被截断
PHOTO_PURGE_CRON="0 40 3 * * ?"

# ---------- JWT ----------
# 必须重新生成，至少 32 个字符，绝不能沿用 dev 环境的
# 生成命令：openssl rand -base64 48
JWT_SECRET=换成新的随机密钥
JWT_EXPIRE=604800000

# ---------- 注册 / 找回密码邮件（必填）----------
# 生产启动自检会检查这两项，缺失直接启动失败：
# 配不上邮件 = 验证码送不到 = 注册功能不可用，与其上线后才发现，不如启动就报错。
# QQ 邮箱：设置 → 账户 → 开启 SMTP 服务，拿到的「授权码」填到 MAIL_AUTH_CODE（不是登录密码）
MAIL_USERNAME=your-account@qq.com
MAIL_AUTH_CODE=你的SMTP授权码
MAIL_FROM_NAME=尘叙阁
# 可选：发件地址，留空则用 MAIL_USERNAME
MAIL_FROM=

# ---------- 日志 ----------
LOG_DIR=/opt/share/logs

# ---------- 分享卡片 ----------
# 分享链接形如 https://域名/api/share/moment/12
# 微信/QQ 抓 og:image 时需要绝对地址，这里填站点根（不带结尾斜杠）
# 留空也能跑（按请求头推导），但 nginx 后建议显式配置，避免抓到 127.0.0.1
SHARE_BASE_URL=https://your.domain.com
