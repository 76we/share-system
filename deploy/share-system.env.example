# 环境变量清单 —— docker compose 通过 env_file 读这个文件
#
# 用法：
#   cp deploy/share-system.env.example deploy/share-system.env
#   chmod 600 deploy/share-system.env      # 里面是密码和密钥
#   # 然后逐项替换下面的「换成xxx」
#
# 这个文件不进 git（deploy/*.env 已在 .gitignore 里排除）。
# 建议另外存一份到密码管理器 —— 服务器重装时，丢了它就是丢了数据库密码。
#
# 两个格式注意（都是实测踩过的）：
#   1. 值不要加引号。env_file 不是 shell，某些 compose 版本会把引号当成值的一部分，
#      于是 PHOTO_PURGE_CRON 变成带引号的字符串，cron 解析失败、定时任务静默不跑。
#   2. 值里有空格没问题（KEY= 后面整行都是值），但结尾不要留空格。

# ── 数据库初始化（仅在 /data/mysql 为空时生效）────────────────────────────
# 第一次启动 MySQL 容器时，用这几个变量建库、建账号。
# 一旦 /data/mysql 里已经有数据，这些会被完全忽略 —— 改密码要进数据库改，改这里没用。
MYSQL_ROOT_PASSWORD=换成root强密码
MYSQL_DATABASE=sharing
# 业务账号。容器创建的这个账号对 MYSQL_DATABASE 有全部权限（含 CREATE/ALTER），
# 正好满足 Flyway 建表和迁移的需要。所以不需要再手工 GRANT。
MYSQL_USER=share
MYSQL_PASSWORD=换成业务账号密码

# ── 应用连接数据库 ────────────────────────────────────────────────────────
# DB_USERNAME / DB_PASSWORD 必须与上面的 MYSQL_USER / MYSQL_PASSWORD 完全一致，
# 否则应用连不上（报 Access denied），而容器本身是健康的，容易误判成代码问题。
# DB_HOST / DB_PORT 由 docker-compose.yml 指定（容器间用服务名 mysql:3306），这里不用配。
DB_NAME=sharing
DB_USERNAME=share
DB_PASSWORD=换成业务账号密码
DB_POOL_SIZE=20

# ── Redis ─────────────────────────────────────────────────────────────────
# REDIS_HOST 同样由 compose 指定为 redis。
# 容器里的 Redis 没有设密码（只在内网共享网络里可达，不发布端口），这里留空。
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ───────────────────────────────────────────────────────────────────
# 必须重新生成，至少 32 字符，绝不能沿用仓库里的 dev 默认值。
# 生成命令：openssl rand -base64 48
# 改这个会让所有已登录用户掉线（token 校验不过），属预期行为。
JWT_SECRET=换成新生成的随机密钥
JWT_EXPIRE=604800000

# ── 注册 / 找回密码邮件 ───────────────────────────────────────────────────
# 生产启动自检会检查这两项，缺失直接启动失败：
# 配不上邮件 = 验证码送不到 = 注册功能不可用，与其上线后才发现，不如启动就报错。
# QQ 邮箱：设置 → 账户 → 开启 SMTP 服务，拿到的是「授权码」，不是登录密码。
MAIL_USERNAME=your-account@qq.com
MAIL_AUTH_CODE=你的SMTP授权码
MAIL_FROM_NAME=尘叙阁
# 可选：发件地址，留空则用 MAIL_USERNAME
MAIL_FROM=

# ── 图片回收 ──────────────────────────────────────────────────────────────
# 删除动态是软删（status=0），满 PHOTO_PURGE_DAYS 天后由定时任务物理删除
# moment_image 行与磁盘文件。留 30 天是给误删留恢复窗口。
PHOTO_PURGE_ENABLED=true
PHOTO_PURGE_DAYS=30
# 每天 03:40，避开备份（03:00）和访问高峰。
# 注意：这里不加引号（见文件头的格式说明）。Quartz 六位格式，最后一位是「任意星期」。
PHOTO_PURGE_CRON=0 40 3 * * ?

# ── 分享卡片 ──────────────────────────────────────────────────────────────
# 微信/QQ 抓 og:image 时需要绝对地址。填站点根，不带结尾斜杠。
# 留空也能跑（按请求头推导），但 nginx 反代后推导出来会是 127.0.0.1，
# 分享出去就是一张破图。所以这里建议显式配。
SHARE_BASE_URL=https://your.domain.com

# ── 跨域（默认留空，同域部署不需要）──────────────────────────────────────
# 前端和接口同域（都由 nginx 提供）时保持留空。
# 只有前端单独挂在别的域名下才需要填，逗号分隔。
CORS_ORIGINS=

# ── 以下由 docker-compose.yml 固定，不要在这里配 ──────────────────────────
#   SPRING_PROFILES_ACTIVE=prod   profile 写错的后果见 DEPLOY.md「常见坑」
#   UPLOAD_DIR=/data/uploads      必须与 volumes 挂载点和 nginx 的 alias 一致
#   DB_HOST=mysql / REDIS_HOST=redis / TZ=Asia/Shanghai
#   LOG_DIR=/tmp/logs             容器日志走 docker logs，不落数据盘
#
# 以下有默认值，一般不用配：
#   DB_PORT=3306  MAIL_HOST=smtp.qq.com  MAIL_PORT=465  SERVER_PORT=8080
