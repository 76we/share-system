[Unit]
Description=Chen Xu Pavilion (share-system) backend
# 数据库和 Redis 都在本机时，先等它们起来
After=network.target mysql.service redis.service
Wants=network.target

[Service]
Type=simple
User=share
Group=share
WorkingDirectory=/opt/share

# 敏感配置全部通过环境变量注入，仓库和 unit 文件里都不出现明文
EnvironmentFile=/opt/share/share-system.env
Environment=SPRING_PROFILES_ACTIVE=prod

ExecStart=/usr/bin/java -Xms256m -Xmx512m -XX:+UseG1GC \
    -jar /opt/share/share-system.jar

# Spring Boot 正常退出时返回 143，别让 systemd 判成失败
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
# 5 分钟内最多重启 5 次，避免启动就崩时无限循环
StartLimitIntervalSec=300
StartLimitBurst=5

StandardOutput=append:/opt/share/logs/stdout.log
StandardError=append:/opt/share/logs/stderr.log

[Install]
WantedBy=multi-user.target
